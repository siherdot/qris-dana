# Lingkungan DANA: sandbox | production
DANA_ENV=sandbox

# Dari onboarding merchant QRIS (dashboard.dana.id)
DANA_CLIENT_ID=
DANA_MERCHANT_ID=
DANA_STORE_ID=

# Private key merchant (PKCS#8). Baris baru boleh ditulis \n.
DANA_PRIVATE_KEY=

# Public key DANA untuk verifikasi webhook (sandbox: dari dokumentasi,
# produksi: minta ke tim DANA). Tempel lewat dashboard.
DANA_PUBLIC_KEY=

DANA_ORIGIN=https://qris.contoh.id
DANA_CHANNEL_ID=95221

# Opsional
PORT=3000
DB_PATH=./data/qris.db
# DANA_BASE_URL=http://127.0.0.1:9999   # untuk uji dengan server tiruan
